{
  "name": "comp-ledger",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"vite client --host 0.0.0.0 --port 3000\"",
    "ingest": "node scripts/ingest.js",
    "build-index": "node scripts/build_index.js",
    "refresh": "node scripts/clean_corpus.js && node scripts/ingest.js data/sources.json && node scripts/build_index.js",
    "server": "node server/index.js",
    "client": "vite client --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.650.0",
    "@aws-sdk/client-s3": "^3.650.0",
    "@fastify/cors": "^9.0.0",
    "@mozilla/readability": "^0.6.0",
    "csv-parse": "^5.5.0",
    "dotenv": "^16.4.0",
    "fastify": "^4.28.0",
    "linkedom": "^0.18.13",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
